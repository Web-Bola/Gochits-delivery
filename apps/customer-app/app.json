{
  "expo": {
    "name": "Gochit's",
    "slug": "gochits-customer",
    "scheme": "gochits",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon.png",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "მისამართის დასადგენად გვჭირდება შენი მდებარეობა"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFCC02"
        }
      ]
    ],
    "ios": {
      "bundleIdentifier": "ge.gochits.customer",
      "supportsTablet": false
    },
    "android": {
      "package": "ge.gochits.customer",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFCC02"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "splash": {
      "image": "./assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFCC02"
    }
  }
}
